    "shiki": "^3.12.2",
    "solid-gpui": "workspace:*",
    "solid-js": "2.0.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

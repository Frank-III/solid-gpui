{
  "name": "@solid-gpui/opencode-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "vite build && node dist/app.js",
    "trace": "vite build && SOLID_GPUI_HOST=../../tools/mock-host.mjs SOLID_GPUI_MOCK_DUMP=1 node dist/app.js",
